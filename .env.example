# Turso database. For local development a plain SQLite file works and needs no token.
# In production use the libsql://... URL and token from Turso (the Vercel integration sets both).
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Optional. Random string of at least 32 characters; allows refreshing cached pages on demand.
VERCEL_BYPASS_TOKEN=

# Optional. Umami website ID for cookieless analytics; leave empty to disable.
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
