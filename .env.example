# Turso database. For local development a plain SQLite file works and needs no token.
# In production use the libsql://... URL and token from Turso (the Vercel integration sets both).
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Random string of at least 32 characters. Lets the ingestion workflow refresh the cached page.
VERCEL_BYPASS_TOKEN=
